# Module 3 Spring Boot backend. Existing Module 3 frontend remains on port 8080.
VITE_API_BASE_URL=http://localhost:8080

# Module 4 defaults to the Vite proxy path below. Vite forwards it to http://localhost:8081,
# avoiding browser CORS changes in the completed Module 4 backend.
VITE_MODULE4_API_BASE_URL=/module4-api

# Dispatch & Route Engine defaults to the Vite proxy path below. Vite forwards it to http://localhost:8082.
VITE_DISPATCH_API_BASE_URL=/dispatch-api
